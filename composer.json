{
    "name": "madj2k/t3-media-utils",
    "type": "typo3-cms-extension",
    "description": "TYPO3 extension providing fully configurable responsive images, media ViewHelpers and reusable partials, with support for picture tags, srcset/sizes and lazy loading.",
    "homepage": "https://www.steffenkroggel.de",
    "license": ["GPL-2.0+"],
    "keywords": ["TYPO3 CMS", "Responsive Images"],
    "support": {
        "email": "developer@steffenkroggel.de"
    },
    "authors": [
        {
            "name": "Steffen Kroggel",
            "email": "developer@steffenkroggel.de",
            "homepage": "https://www.steffenkroggel.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
		"ext-fileinfo": "*",
        "typo3/cms-core": " ~13.4.0 || ~14.4.0"
	},
	"replace": {
		"sitegeist/sms-responsive-images": "*"
	},
    "autoload": {
        "psr-4": {
            "Madj2k\\MediaUtils\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "media_utils"
        }
    }
}
