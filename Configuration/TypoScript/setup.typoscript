plugin.tx_mediautils {

	view {
		layoutRootPaths {
			0 = EXT:media_utils/Resources/Private/Layouts/
			10 = {$plugin.tx_mediautils.view.layoutRootPath}
		}
		templateRootPaths {
			0 = EXT:media_utils/Resources/Private/Templates/
            10 = {$plugin.tx_mediautils.view.templateRootPath}
        }
		partialRootPaths {
			0 = EXT:media_utils/Resources/Private/Partials/
			10 = {$plugin.tx_mediautils.view.partialRootPath}
        }
	}

	persistence {
		storagePid = {$plugin.tx_mediautils.persistence.storagePid}
	}

	settings {

	}
}

/**
 * Inherit partials to EXT:mask
 */
lib.maskContentElement {
    partialRootPaths {
        1712245685 = {$plugin.tx_mediautils.view.partialRootPath}
    }
}
/**
 * Inherit partials to EXT:content-blocks
 */
lib.contentBlock {
    partialRootPaths {
        1712245685 = {$plugin.tx_mediautils.view.partialRootPath}
    }
}


/**
 * Configuration for responsive images
 */
lib.txMediaUtils.responsiveImages {
    loading = {$plugin.tx_mediautils.settings.responsiveImages.loading}
    lazyload = {$plugin.tx_mediautils.settings.responsiveImages.lazyload}

    placeholder {
        size = {$plugin.tx_mediautils.settings.responsiveImages.placeholder.size}
        inline = {$plugin.tx_mediautils.settings.responsiveImages.placeholder.inline}
    }

    srcset = {$plugin.tx_mediautils.settings.responsiveImages.srcset}
    sizes = {$plugin.tx_mediautils.settings.responsiveImages.sizes}
    breakpoints {
         0 {
            cropVariant = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.desktop.cropVariant}
            media = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.desktop.media}
            srcset = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.desktop.srcset}
            sizes = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.desktop.sizes}
        }

        1 {
            cropVariant = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.tablet.cropVariant}
            media = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.tablet.media}
            srcset = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.tablet.srcset}
            sizes = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.tablet.sizes}
        }

        2 {
            cropVariant = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.mobile.cropVariant}
            media = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.mobile.media}
            srcset = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.mobile.srcset}
            sizes = {$plugin.tx_mediautils.settings.responsiveImages.breakpoints.mobile.sizes}
        }
    }

    renderHeightAttribute = {$plugin.tx_mediautils.settings.responsiveImages.renderHeightAttribute}
    ignoreFileExtensions = {$plugin.tx_mediautils.settings.responsiveImages.ignoreFileExtensions}
    fileExtension = {$plugin.tx_mediautils.settings.responsiveImages.fileExtension}

    class = {$plugin.tx_mediautils.settings.responsiveImages.class}
}



/**
 * Inherit settings
 */
// legacy
lib.madj2kMediaUtils.responsiveImages < lib.txMediaUtils.responsiveImages
lib.contentElement.settings.tx_smsresponsiveimages < lib.txMediaUtils.responsiveImages
lib.contentBlock.settings.tx_smsresponsiveimages < lib.txMediaUtils.responsiveImages
lib.maskContentElement.settings.tx_smsresponsiveimages < lib.contentElement.settings.tx_smsresponsiveimages

// new
lib.contentElement.settings.txMediaUtils < lib.txMediaUtils
lib.contentBlock.settings.txMediaUtils < lib.txMediaUtils
lib.maskContentElement.settings.txMediaUtils < lib.txMediaUtils
